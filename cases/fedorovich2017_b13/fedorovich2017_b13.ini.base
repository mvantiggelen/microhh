[master]
npx=1
npy=1

[grid]
itot=256
jtot=256
ktot=392
xsize=1024.
ysize=1024.
zsize=1568.
swspatialorder=2

[pres]
# DCT pressure solve: required together with [boundary_lateral] sw_openbc.
sw_openbc=true

[advec]
swadvec=2i5
cflmax=1.2
fluxlimit_list=thl,qt

[limiter]
limitlist=qt

[diff]
swdiff=smag2
dnmax=0.4

[thermo]
# Dry in practice (qt = 0 everywhere, no condensation), but run through the
# moist code path: the IB wall model needs swthermo=moist.
swthermo=moist
swbasestate=boussinesq
thvref0=300.
pbot=100000.
swupdatebasestate=0

[force]
swlspres=geo
fc=1.e-4
swls=0
swwls=0

[boundary]
# The domain floor is buried under the terrain; the IB is the surface.
mbcbot=noslip
mbctop=freeslip
swboundary=surface
z0m=0.05
z0h=0.005
sbcbot=dirichlet
sbctop=neumann
sbot[thl]=300.
stop[thl]=0.
sbot[qt]=0.
stop[qt]=0.

[boundary_lateral]
sw_openbc=true
sw_openbc_uv=true
sw_openbc_w=false
sw_neumann_w=true
sw_wtop_2d=false
sw_timedep=false
loadfreq=600
slist=thl,qt
sw_sponge=true
n_sponge=5
tau_sponge=20
w_diff=0.003
# Terrain-following periodic boundary: every edge fed from the opposite edge at the same height above
# the surface; thl keeps its anomaly relative to the environment.
sw_lbc_tf_periodic=true
lbc_tf_gradient[thl]=0.
lbc_tf_gradient[qt]=0.

[IB]
sw_immersed_boundary=dem
n_idw_points=5
sw_dem_halo_replicate=true
sw_wall_model=most
z0m=0.05
z0h=0.005
sw_scalar_flux=true
sw_wall_stability_vertical=false
sw_scalar_flux_vertical=false
sw_momentum_flux=true
sw_momentum_flux_vertical=true
sw_strain_most=true
sw_strain_most_vertical=false
strain_most_min=0.05
sw_impermeable=false
sw_blank_solid=true
sw_advec_wall=true
evisc_solid=cap
sbcbot=dirichlet
sbot[thl]=300.
sbot[qt]=0.
sbot_spatial=thl
sw_timedep_sbot=true
sbot_loadtime=60
diag_z_mom=10
diag_z_scalar=2

[fields]
visc=1.e-5
svisc=1.e-5
rndseed=2
rndamp[thl]=0.1
rndz=50.
rndexp=2.

[buffer]
swbuffer=1
zstart=1250.
sigma=0.00223
beta=2.

[time]
starttime=0.
endtime=54000.
dt=1.
dtmax=10.
savetime=3600.
outputiter=100
adaptivestep=true
rkorder=3
iotimeprec=0

[stats]
swstats=1
sampletime=600.
masklist=ib

[cross]
swcross=1
sampletime=600.
xz=128.,384.,640.,896.
crosslist=u,v,w,thl

[dump]
swdump=0
