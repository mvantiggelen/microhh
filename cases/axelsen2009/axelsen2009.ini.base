[master]
npx=1
npy=1

[grid]
itot=96
jtot=32
ktot=190
xsize=9600.
ysize=3200.
zsize=1900.
swspatialorder=2

[pres]
# DCT pressure solve: required together with [boundary_lateral] sw_openbc.
sw_openbc=true

[advec]
# As recommended with the IB.
swadvec=2i5
cflmax=1.3
fluxlimit_list=thl,qt

[limiter]
limitlist=qt

[diff]
swdiff=smag2
dnmax=0.3

[thermo]
# Moist anelastic, but dry in practice (qt = 0, no condensation).
# Potential temperatures are relative to the site's surface pressure, as in
# the paper (pbot = 1000 hPa makes theta = T at the surface).
swthermo=moist
swbasestate=anelastic
pbot=100000.
swupdatebasestate=1

[force]
# The paper has no Coriolis and no ambient wind. --fc switches Coriolis on
# (swlspres=geo with a zero geostrophic wind).
swlspres=0
swls=0
swwls=0

[boundary]
# The domain floor is buried under the terrain; the IB is the surface.
mbcbot=noslip
mbctop=freeslip
swboundary=surface
swconstantz0=1
z0m=0.005
z0h=0.0005
sbcbot=dirichlet
sbctop=neumann
sbot[thl]=280.
stop[thl]=0.
sbot[qt]=0.
stop[qt]=0.

[boundary_lateral]
# Open boundaries (DCT, sponge of 10 cells), but every edge is fed from the
# OPPOSITE edge at the same height above the surface (terrain-following
# periodic boundary): the IB version of the paper's periodic slope frame.
sw_openbc=true
sw_openbc_uv=true
sw_openbc_w=false
sw_neumann_w=true
sw_wtop_2d=false
sw_timedep=false
loadfreq=3600
slist=thl,qt
sw_sponge=true
n_sponge=10
tau_sponge=20
w_diff=0.003
sw_lbc_tf_periodic=true
lbc_tf_gradient[thl]=0.
lbc_tf_gradient[qt]=0.

[IB]
# The recommended IB settings for an ice surface: no vegetation, no surface
# energy balance, no z0m map. Momentum: the staircase method (the MOST wall
# stress as a source term); axelsen2009_input.py --momentum vr replaces these
# keys by the velocity reconstruction (needs a MicroHH build with it).
sw_immersed_boundary=dem
n_idw_points=5
sw_dem_halo_replicate=true
sw_wall_model=most
z0m=0.005
z0h=0.0005
z0h_model=yang2008
z0h_ratio=10
z0_nu=1.5e-05
z0_yang_beta=7.2
z0h_min=1e-10
z0h_max=0.1
sw_scalar_flux=true
sw_wall_stability_vertical=false
sw_scalar_flux_vertical=false
# momentum, staircase: MOST wall stress as a source term, eddy viscosity
# rescaled to it, w on the floor faces along the sub-grid slope, and
# air-only momentum exchange (below)
sw_momentum_flux=true
sw_momentum_flux_vertical=true
sw_strain_most=true
sw_strain_most_vertical=false
strain_most_min=0.05
sw_impermeable=false
sw_wall_kinematic=true
# only MOST and the resolved pressure exchange momentum with the
# terrain (no advective/SGS momentum flux into the rock); needs swadvec=2i5
sw_momentum_air_only=true
# the eddy viscosity inside the terrain capped AFTER the wall damping (MOST
# rescaling), so the terrain does not set the diffusion limit on dt
evisc_solid=cap_last
dn_probe_every=20000
diag_z_mom=10
diag_z_scalar=2
sw_wall_slope=true
wall_dn_min=0.1
sw_blank_solid=true
# keep the terrain inert through the RK update (zero tendencies
# in the blanked cells, physics tendencies at the momentum ghost cells)
sw_blank_solid_tend=true
sw_advec_wall=true
# the inflow wall faces carry s_air + delta: closed heat budget
sw_advec_wall_conserve=true
# IB fluxes and drag (taux_form_ib, taux_skin_ib, ...) as interval
# means over the output interval; output only
sw_flux_accum=true
# Mason's wall damping with the height above the local surface
sw_mason_wall=true
# wall model evaluated at a point wall_sample_dz*dz along the normal above
# the true surface
sw_wall_sample=true
wall_sample_dz=1.5
sw_tf_cross=true
tf_cross_heights=5
# dirichlet: sbot = surface value; flux: sbot = kinematic flux
sbcbot=dirichlet
sbot[thl]=280.
sbot[qt]=0.
sbot_spatial=thl,qt
sw_timedep_sbot=false

[fields]
visc=1.e-5
svisc=1.e-5
rndseed=2
rndamp[thl]=0.1
rndz=100.
rndexp=2.

[buffer]
swbuffer=1
swupdate=0
zstart=1650.
sigma=0.00223
beta=2.

[time]
starttime=0.
endtime=18000.
dt=1.
dtmax=5.
savetime=3600.
outputiter=100
adaptivestep=true
rkorder=3
iotimeprec=0

[stats]
swstats=1
sampletime=300.
masklist=ib

[cross]
swcross=1
sampletime=300.
xz=800.,2400.
crosslist=u,w,thl

[dump]
swdump=0
