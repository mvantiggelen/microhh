{
 "reference": {
  "citation": "Andren, A., Brown, A. R., Graf, J., Mason, P. J., Moeng, C.-H., Nieuwstadt, F. T. M. and Schumann, U. (1994). Large-eddy simulation of a neutrally stratified boundary layer: A comparison of four computer codes. Q. J. R. Meteorol. Soc. 120, 1457-1484.",
  "doi": "https://doi.org/10.1002/qj.49712052003"
 },
 "method": "Tables typed in from the PDF. Figures: pages rasterized at 300 dpi (pdftoppm), plot frames located from the axis lines, data coordinates mapped linearly from the frame and axis labels, and at each height the dark-pixel runs along that row were listed and assigned to curves by continuity and line style (by eye). Where the five curves cannot be told apart (overlapping dashed lines) only the envelope (min/max over all codes and runs) is given. Uncertainty: about +-1% of the axis range from the reading itself, plus a frame skew of up to 0.5%; near the surface (zf/u* < 0.02) and in the legend rows (zf/u* 0.26-0.33, right half of each panel) curve assignment is uncertain - see \"uncertainty\" per item. The digitized values are NOT the paper's data, only a reading of its figures.",
 "normalisation": {
  "z": "zf/u*, with each code's own u* (so the lid at 1500 m sits at zf/u* = 0.33-0.37)",
  "velocity_moments": "divided by u*^2 (u* = (uw0^2 + vw0^2)^(1/4), surface value)",
  "scalar": "c* = (wc)0/u*, (wc)0 = 1e-3 kg m-2 s-1 (rho = 1 kg m-3), so c^2/c*^2 and wc/(u* c*)",
  "phi_M": "kappa z/u* sqrt((d<u>/dz)^2 + (d<v>/dz)^2), Eq. (8); kappa = 0.4 assumed (not stated in the paper)",
  "phi_C": "kappa z/c* d<c>/dz, Eq. (9)",
  "averaging": "statistics over the last 3/f of a 10/f run, i.e. t = 7e4 ... 1e5 s (section 3)"
 },
